<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1200" width="1600" height="1200">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0a0a0b"/>
      <stop offset="100%" stop-color="#11111a"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#7c3aed"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>
    <radialGradient id="glow" cx="0.8" cy="0.2" r="0.7">
      <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#06b6d4" stop-opacity="0"/>
    </radialGradient>
    <filter id="cardshadow" x="-50%" y="-50%" width="200%" height="200%">
      <feDropShadow dx="0" dy="20" stdDeviation="30" flood-color="#000" flood-opacity="0.45"/>
    </filter>
  </defs>

  <rect width="1600" height="1200" fill="url(#bg)"/>
  <rect width="1600" height="1200" fill="url(#glow)"/>

  <g filter="url(#cardshadow)">
    <!-- Email card (light themed for that "real email client" feel) -->
    <rect x="380" y="200" width="840" height="820" rx="14" fill="#ffffff"/>

    <!-- Brand header bar -->
    <rect x="380" y="200" width="840" height="120" fill="url(#accent)"/>
    <circle cx="430" cy="260" r="22" fill="#0a0a0b"/>
    <text x="430" y="269" font-family="Geist, system-ui, sans-serif" font-size="18" font-weight="700" fill="#ededef" text-anchor="middle">A</text>
    <text x="475" y="269" font-family="Geist, system-ui, sans-serif" font-size="20" font-weight="600" fill="#0a0a0b">Adoreal</text>

    <!-- Email body -->
    <text x="430" y="400" font-family="Geist, system-ui, sans-serif" font-size="32" font-weight="600" fill="#0a0a0b">Confirm your email address</text>

    <text x="430" y="460" font-family="Geist, system-ui, sans-serif" font-size="15" fill="#52525b">Hi Sheldon,</text>
    <text x="430" y="492" font-family="Geist, system-ui, sans-serif" font-size="15" fill="#52525b">Welcome to Adoreal. Tap the button below to confirm your</text>
    <text x="430" y="514" font-family="Geist, system-ui, sans-serif" font-size="15" fill="#52525b">email address and finish setting up your account.</text>

    <!-- CTA button -->
    <rect x="430" y="560" width="280" height="58" rx="10" fill="#0a0a0b"/>
    <text x="570" y="596" font-family="Geist, system-ui, sans-serif" font-size="15" font-weight="600" fill="#ededef" text-anchor="middle">Confirm email →</text>

    <text x="430" y="680" font-family="Geist, system-ui, sans-serif" font-size="13" fill="#9ca3af">Or copy and paste this URL into your browser:</text>
    <text x="430" y="708" font-family="Geist Mono, monospace" font-size="12" fill="#52525b">https://adoreal.com/auth/realms/adoreal-app/login-actions/...</text>

    <!-- Divider -->
    <line x1="430" y1="780" x2="1170" y2="780" stroke="#e4e4e7" stroke-width="1"/>

    <text x="430" y="820" font-family="Geist, system-ui, sans-serif" font-size="13" fill="#9ca3af">If you didn&apos;t create an account, you can safely ignore this email.</text>
    <text x="430" y="850" font-family="Geist, system-ui, sans-serif" font-size="13" fill="#9ca3af">This link expires in 24 hours.</text>

    <!-- Footer -->
    <text x="430" y="950" font-family="Geist Mono, monospace" font-size="11" fill="#9ca3af" letter-spacing="2">ADOREAL · SEATTLE, WA</text>
    <text x="430" y="975" font-family="Geist Mono, monospace" font-size="11" fill="#9ca3af" letter-spacing="2">UNSUBSCRIBE · PRIVACY</text>
  </g>

  <text x="80" y="120" font-family="Geist Mono, monospace" font-size="12" fill="#9ca3af" letter-spacing="3">TRANSACTIONAL EMAIL · BRANDED THEME</text>
</svg>
