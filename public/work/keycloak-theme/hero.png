<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" width="1600" height="900">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0a0a0b"/>
      <stop offset="100%" stop-color="#11111a"/>
    </linearGradient>
    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#7c3aed"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>
    <radialGradient id="glow" cx="0.85" cy="0.15" r="0.6">
      <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#7c3aed" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="glow2" cx="0.15" cy="0.85" r="0.6">
      <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#06b6d4" stop-opacity="0"/>
    </radialGradient>
    <filter id="cardshadow" x="-50%" y="-50%" width="200%" height="200%">
      <feDropShadow dx="0" dy="20" stdDeviation="25" flood-color="#000" flood-opacity="0.4"/>
    </filter>
  </defs>

  <rect width="1600" height="900" fill="url(#bg)"/>
  <rect width="1600" height="900" fill="url(#glow)"/>
  <rect width="1600" height="900" fill="url(#glow2)"/>

  <g opacity="0.04" stroke="#ededef" stroke-width="1">
    <line x1="0" y1="200" x2="1600" y2="200"/>
    <line x1="0" y1="400" x2="1600" y2="400"/>
    <line x1="0" y1="600" x2="1600" y2="600"/>
    <line x1="0" y1="800" x2="1600" y2="800"/>
    <line x1="400" y1="0" x2="400" y2="900"/>
    <line x1="800" y1="0" x2="800" y2="900"/>
    <line x1="1200" y1="0" x2="1200" y2="900"/>
  </g>

  <g filter="url(#cardshadow)">
    <rect x="540" y="180" width="520" height="540" rx="20" fill="#15151a" stroke="#2a2a32" stroke-width="1"/>

    <circle cx="800" cy="260" r="28" fill="url(#accent)"/>
    <text x="800" y="270" font-family="Geist, system-ui, sans-serif" font-size="22" font-weight="700" fill="#0a0a0b" text-anchor="middle">A</text>

    <text x="800" y="335" font-family="Geist, system-ui, sans-serif" font-size="32" font-weight="600" fill="#ededef" text-anchor="middle">Sign in to Adoreal</text>
    <text x="800" y="370" font-family="Geist, system-ui, sans-serif" font-size="15" fill="#9ca3af" text-anchor="middle">Continue to your account</text>

    <text x="580" y="430" font-family="Geist Mono, monospace" font-size="11" fill="#9ca3af" letter-spacing="2">EMAIL</text>
    <rect x="580" y="445" width="440" height="50" rx="10" fill="#0a0a0b" stroke="#2a2a32" stroke-width="1"/>
    <text x="600" y="476" font-family="Geist, system-ui, sans-serif" font-size="15" fill="#ededef">you@adoreal.com</text>

    <text x="580" y="525" font-family="Geist Mono, monospace" font-size="11" fill="#9ca3af" letter-spacing="2">PASSWORD</text>
    <rect x="580" y="540" width="440" height="50" rx="10" fill="#0a0a0b" stroke="#2a2a32" stroke-width="1"/>
    <text x="600" y="571" font-family="Geist, system-ui, sans-serif" font-size="15" fill="#ededef" letter-spacing="3">••••••••••</text>

    <rect x="580" y="615" width="440" height="52" rx="10" fill="url(#accent)"/>
    <text x="800" y="647" font-family="Geist, system-ui, sans-serif" font-size="15" font-weight="600" fill="#0a0a0b" text-anchor="middle">Continue</text>
  </g>

  <text x="80" y="100" font-family="Geist Mono, monospace" font-size="11" fill="#9ca3af" letter-spacing="3">KEYCLOAK · KEYCLOAKIFY · REACT</text>
  <text x="1520" y="100" font-family="Geist Mono, monospace" font-size="11" fill="#9ca3af" letter-spacing="3" text-anchor="end">2026</text>
  <text x="80" y="830" font-family="Geist, system-ui, sans-serif" font-size="13" fill="#9ca3af">Themed identity surface — login, OTP, email — built on Keycloakify.</text>
</svg>
